# Environment Variables — Samarthan Golden Hour Triage
# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Required for real AI triage (GPT-4o-mini). Without this, the app falls back
# to a rule-based mock triage so you can still run the UI with zero setup.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required to persist complaints and (optionally) enforce the daily rate limit.
# Free Postgres: https://neon.tech — create a project, copy the pooled connection string.
# Without this, complaints aren't saved and the daily rate limit is skipped (unlimited local use).
DATABASE_URL=

# Direct/unpooled connection, used only by scripts/migrate.mjs for schema changes.
# Neon provides this alongside the pooled URL above.
DATABASE_URL_UNPOOLED=

# Base URL of your running app (used in generated links/messages).
NEXT_PUBLIC_APP_URL=http://localhost:3000
